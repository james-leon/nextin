# ─────────────────────────────────────────────────────────────
# NextIn — variables d'environnement (aucune valeur ici, jamais de secret dans Git)
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (QR codes, liens WhatsApp, PDF). Local : http://localhost:3000
APP_URL=

# Supabase — Dashboard → Project Settings → API / Database ; jeton : Account → Access Tokens
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Cloudflare Turnstile (widget invisible) — dash.cloudflare.com → Turnstile.
# La clé secrète est aussi à saisir dans Supabase → Authentication → Attack Protection → Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sel de hachage des adresses IP (rate limiting, audit) — chaîne aléatoire longue
IP_HASH_SALT=

# Données de démo (scripts/seed-demo.ts) — mot de passe des comptes de démo
SEED_DEMO_PASSWORD=

# M6 — ElevenLabs (génération de la bibliothèque vocale)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID=

# M7 — WhatsApp Cloud API (détail : docs/modules/M7.md). Sans WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID :
# faux fournisseur (rien n'est envoyé, textes lisibles avec `pnpm notify:outbox`).
# Meta for Developers → votre app → WhatsApp → API Setup (numéro, identifiant du numéro) ;
# Business Settings → System users (jeton permanent) ; App settings → Basic (App secret).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Chaîne de votre choix, saisie aussi dans Meta → WhatsApp → Configuration → Webhook → Verify token
WHATSAPP_VERIFY_TOKEN=
# Numéro WhatsApp de NextIn au format international, ex. 2376XXXXXXXX (bouton « Recevoir mes alertes »)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# M7 — Web push (npx web-push generate-vapid-keys) ; VAPID_SUBJECT = mailto:adresse-de-contact
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# M7 — SMS de secours (console = faux fournisseur, en attendant le choix du fournisseur)
SMS_PROVIDER=console

# M7 — Secret partagé entre la base (pg_net) et l'expéditeur /api/notifications/dispatch, ≥ 32 caractères aléatoires.
# Après le déploiement : `pnpm notify:configure` (enregistre l'adresse et le secret dans Supabase Vault).
NOTIFY_DISPATCH_SECRET=

# M9 — Fond de carte « À proximité » (facultatif). Modèle d'URL de tuiles d'un fournisseur sous contrat
# (ex. MapTiler, Stadia Maps : https://…/{z}/{x}/{y}.png?key=…) et mention exigée par le fournisseur.
# Sans valeur : plan schématique (distances à vol d'oiseau), aucune requête vers un service de cartes.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# M10a — Paiement Mobile Money via agrégateur (comparatif : docs/payment-providers.md).
# fake = faux fournisseur (développement, démo) : aucun débit réel, numéro en 99999 = échec simulé.
# Clés de l'agrégateur retenu à ajouter ici lors du branchement de son adaptateur (packages/payments).
PAYMENT_PROVIDER=fake
# Secret de signature des webhooks de paiement (HMAC SHA-256), ≥ 16 caractères aléatoires. Obligatoire.
PAYMENT_WEBHOOK_SECRET=
# Faux fournisseur seulement : délai de « validation sur le téléphone » en millisecondes (défaut 3000).
PAYMENT_FAKE_DELAY_MS=

# M10a — E-mails transactionnels (rappels d'abonnement, reçus). console = affichés dans le terminal, en attendant
# le choix du fournisseur (ex. Resend, Brevo).
EMAIL_PROVIDER=console
