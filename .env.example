# ─────────────────────────────────────────────────────────────
# NextIn — variables d'environnement (aucune valeur ici, jamais de secret dans Git)
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (QR codes, liens WhatsApp, PDF). Local : http://localhost:3000
APP_URL=

# Supabase — Dashboard → Project Settings → API / Database ; jeton : Account → Access Tokens
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Cloudflare Turnstile (widget invisible) — dash.cloudflare.com → Turnstile.
# La clé secrète est aussi à saisir dans Supabase → Authentication → Attack Protection → Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sel de hachage des adresses IP (rate limiting, audit) — chaîne aléatoire longue
IP_HASH_SALT=

# Données de démo (scripts/seed-demo.ts) — mot de passe des comptes de démo
SEED_DEMO_PASSWORD=

# M6 — ElevenLabs (génération de la bibliothèque vocale)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID=

# M7 — WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# M7 — Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# M7 — SMS de secours (console = faux fournisseur de développement)
SMS_PROVIDER=console
