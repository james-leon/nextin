{
  "name": "nextin",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @nextin/web test:e2e",
    "db:start": "node scripts/local-env.mjs npx supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,postgres-meta,storage-api,realtime",
    "db:reset": "node scripts/local-env.mjs npx supabase db reset",
    "db:test": "node scripts/db-test.mjs",
    "db:push": "node scripts/supabase-remote.mjs push",
    "db:link": "node scripts/supabase-remote.mjs link",
    "seed:demo": "node --env-file-if-exists=apps/web/.env.local --import tsx scripts/seed-demo.ts",
    "db:types": "node scripts/db-types.mjs",
    "e2e:local": "node scripts/local-env.mjs pnpm --filter @nextin/web build && node scripts/local-env.mjs pnpm --filter @nextin/web test:e2e",
    "db:stop": "node scripts/local-env.mjs npx supabase stop",
    "seed:demo:local": "node scripts/local-env.mjs node --env-file-if-exists=apps/web/.env.local --import tsx scripts/seed-demo.ts",
    "dev:local": "node scripts/local-env.mjs pnpm --filter @nextin/web dev"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "22.20.5",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
